{
  "schema_version": "2.0",
  "training_sequences": ["MI01", "MI02", "MI03"],
  "validation_sequences": ["MI04"],
  "test_sequences": ["MI05"],
  "features": [
    "area",
    "perimeter",
    "eccentricity",
    "solidity",
    "extent",
    "major_axis_length",
    "minor_axis_length",
    "aspect_ratio"
  ],
  "classifier": {
    "type": "RandomForestClassifier",
    "n_estimators": 300,
    "class_weight": "balanced",
    "random_state": 42,
    "n_jobs": 1
  }
}
